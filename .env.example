# This is a separate process environment. Do not copy keys into source control.
FACETIME_MEDIA_BRIDGE_SECRET=
DEEPGRAM_API_KEY=
# Required for Twilio's signed WebSocket handshake verification. These must
# match Chusky's root environment; do not expose either value publicly.
TWILIO_AUTH_TOKEN=
# Set this to the public WSS endpoint only when Twilio voice is enabled.
TWILIO_MEDIA_STREAM_URL=wss://your-voice-domain.example/twilio/stream
# Low-latency conversational-turn detection and streaming speech.
VOICE_STT_MODEL=flux-general-en
VOICE_STT_EAGER_EOT_THRESHOLD=0.45
VOICE_STT_EOT_THRESHOLD=0.65
VOICE_STT_EOT_TIMEOUT_MS=1200
VOICE_TTS_MODEL=flux-haley-en
VOICE_BARGE_IN_MIN_CHARS=2
VOICE_GREETING=Hi, this is Chusky. How can I help?
# For Railway, these point to the public Chusky service. The bridge authenticates
# requests with FACETIME_MEDIA_BRIDGE_SECRET.
CHUSKY_VOICE_TURN_URL=https://chusky.up.railway.app/internal/facetime/turn
CHUSKY_VOICE_STATUS_URL=https://chusky.up.railway.app/internal/facetime/status
VOICE_BRIDGE_HOST=0.0.0.0
# Local/Oracle fallback. Railway's injected PORT takes precedence.
VOICE_BRIDGE_PORT=3004
VOICE_BRIDGE_MAX_CALL_SECONDS=7200
VOICE_BRIDGE_MAX_ACTIVE_CALLS=4
VOICE_BRIDGE_LOG_LEVEL=INFO
